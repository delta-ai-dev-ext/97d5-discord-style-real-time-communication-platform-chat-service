# chat_service local configuration (copy to .env for local runs only; never used in production)
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat_service
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=chat_service
CHAT_KAFKA_CONSUMER_GROUP=chat_service
COMMUNITY_SERVICE_URL=http://localhost:3001
SERVICE_TOKEN=local-service-token
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_AUDIENCE=chat_service
ACCESS_CHECK_TIMEOUT_MS=300
RATE_LIMIT_SEND_PER_MINUTE=30
SHUTDOWN_TIMEOUT_SECONDS=25
LOG_LEVEL=info
