{
  "name": "chat_service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Persists and serves text channel messages for the real-time communication platform.",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "bun x eslint src/ tests/",
    "db:generate": "bun x drizzle-kit generate",
    "db:push": "bun x drizzle-kit push"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.4",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
